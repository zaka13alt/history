{
    on_demand_tls {
        ask http://localhost/internal-check
    }
}

# Catch-all for both HTTP (port 80) and HTTPS (port 443)
:80, :443 {
    @is_upgrade {
        path /wisp/*
        header Upgrade *
    }

    handle @is_upgrade {
        reverse_proxy localhost:3000 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    handle {
        root * /usr/share/caddy
        file_server
    }

    tls {
        on_demand
    }
}

# Dummy check endpoint for local validation
http://localhost {
    respond /internal-check 200
}

# localhost: on-demand TLS ask check, FlareSolverr, and static files.
# This site wins over :80 for Host: localhost, so localhost routes must live here.
http://localhost, http://127.0.0.1 {
	# On-demand TLS gate (Caddy calls it with ?domain=<host>): no certs for
	# hostnames over 60 chars or for wildcard-DNS hostnames.
	@askTooLong expression `{http.request.uri.query.domain}.size() > 60`
	@askWildcard expression `{http.request.uri.query.domain}.matches(r'(?i)(^|\.)(nip\.io|sslip\.io|xip\.io|nip\.direct|sslip\.net|traefik\.me|lvh\.me|localtest\.me|vcap\.me|lacolhost\.com|localhost\.direct|local\.gd|anyip\.dev|ip\.addr\.tools|backname\.io|fuf\.me|plesk\.page|nip\.lol|hipio\.io|ipq\.co)$|(^|[.-])[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[a-z]|(^|[.-])[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}\.[a-z]')`
	handle /internal-check {
		respond @askTooLong "refused: hostname over 60 characters" 403
		respond @askWildcard "refused: wildcard DNS hostname" 403
		respond 200
	}

	import flaresolverr

	handle {
		root * /usr/share/caddy
		file_server
	}
}

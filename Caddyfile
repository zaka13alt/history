{
    # Check against Caddy's own local route
    on_demand_tls {
        ask http://localhost/internal-check
    }
}

:443 {
    @is_upgrade {
        path /wisp/*
        header Upgrade *
    }

    handle @is_upgrade {
        reverse_proxy localhost:3000 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    handle {
        root * /usr/share/caddy
        file_server
    }

    tls {
        on_demand
    }
}

# Always returns 200 to satisfy Caddy's safety requirement
http://localhost {
    respond /internal-check 200
}

:443 {
    # Turns on internal/on-demand style TLS behavior
    tls internal

    # Define a matcher for WebSocket / Protocol Upgrade requests
    @is_upgrade {
        path /wisp/*
        header Upgrade *
    }

    # 1. Handle upgrades under /wisp/
    handle_path @is_upgrade {
        reverse_proxy localhost:8080 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # 2. Handle normal assets under /wisp/ (no upgrade header)
    handle_path /wisp/* {
        root * /var/www/wisp-assets
        file_server
    }

    # 3. Handle all other paths (Fallback)
    handle {
        root * /var/www/html
        file_server
    }
}

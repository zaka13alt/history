{
    # Enable On-Demand TLS globally
    tls {
        on_demand
    }
}

:443 {
    # Match WebSocket upgrade requests on /wisp/
    @is_upgrade {
        path /wisp/*
        header Upgrade *
    }

    # Send WebSocket traffic to Node/service on port 3000
    handle @is_upgrade {
        reverse_proxy localhost:3000 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # Serve normal website
    handle {
        root * /usr/share/caddy
        file_server
    }

    # Force the site block to use On-Demand TLS
    tls {
        on_demand
    }
}

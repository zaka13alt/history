{
	on_demand_tls {
		ask http://localhost/internal-check
	}
}

# FlareSolverr. It only serves /v1 (no trailing slash), so drop one if present.
(flaresolverr) {
	handle_path /flaresolverr/* {
		@fsTrailingSlash path_regexp fstrail ^(.+)/$
		rewrite @fsTrailingSlash {re.fstrail.1}

		reverse_proxy localhost:8191
	}
}

# Host-based denials. These are handle blocks (not bare respond) so they run
# before every other handle; a bare respond is ordered after handle and never fired.
(deny_hosts) {
	@tooLong header_regexp Host ^.{61,}$
	@whm header Host *whm*
	@cpanel header Host *cpanel*
	@login header Host *login*

	handle @tooLong {
		respond "Request denied" 493
	}
	handle @whm {
		respond "Request denied" 493
	}
	handle @cpanel {
		respond "Request denied" 493
	}
	handle @login {
		respond "Request denied" 493
	}
}

# Online users counter: a WebSocket on the Node app (node/use.js) that pushes
# {"online":N}. Caddy only proxies it; it needs no timeouts since sockets stay open.
(use_counter) {
	@use path /use /use/*
	handle @use {
		reverse_proxy localhost:3000 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
}

# ITCode lesson login: the Node app on 3000 checks the posted password.
(password_verify) {
	@password_verify path /password/verify
	handle @password_verify {
		reverse_proxy localhost:3000
	}
}

(proxy_routes) {
	import flaresolverr
	import use_counter
	import password_verify

	# Upstream placeholders can't be combined with a scheme, so each scheme and
	# port form gets its own handler with an explicit dial address.
	@np_https {
		method GET
		path_regexp dest ^/np/https:/+(?P<domain>[^/:]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_https {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.domain}:443 {
			header_up Host {re.dest.domain}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"

			transport http {
				tls
				tls_server_name {re.dest.domain}
			}
		}
	}

	@np_https_port {
		method GET
		path_regexp dest ^/np/https:/+(?P<host>[^/:]+):(?P<port>[0-9]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_https_port {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.host}:{re.dest.port} {
			header_up Host {re.dest.host}:{re.dest.port}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"

			transport http {
				tls
				tls_server_name {re.dest.host}
			}
		}
	}

	@np_http {
		method GET
		path_regexp dest ^/np/http:/+(?P<domain>[^/:]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_http {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.domain}:80 {
			header_up Host {re.dest.domain}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"
		}
	}

	@np_http_port {
		method GET
		path_regexp dest ^/np/http:/+(?P<host>[^/:]+):(?P<port>[0-9]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_http_port {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.host}:{re.dest.port} {
			header_up Host {re.dest.host}:{re.dest.port}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"
		}
	}

	# Wisp routes: /api, /api/, /api/anything, /wisp, /wisp/... all become
	# exactly /wisp/ (query kept), which is the path epoxy-server expects.
	# (strip_prefix + /wisp{uri} broke WebSockets over HTTP/2 in browsers.)
	handle /api* {
		rewrite * /wisp/?{query}

		reverse_proxy localhost:3000 {
			header_up Host {upstream_hostport}

			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /wisp* {
		rewrite * /wisp/?{query}

		reverse_proxy localhost:3000 {
			header_up Host {upstream_hostport}

			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Existing local /np proxy fallback
	handle /np/* {
		reverse_proxy localhost:3000 {
			header_up Host {upstream_hostport}
			header_up X-No-Proxy true

			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
}

# ITCode lesson page (itcode.html): served at the root of itcode.vip and at /itcode/
# on every other host. Its assets and the study.html it swaps to use absolute paths.
(itcode_site) {
	@itcodeHost host itcode.vip www.itcode.vip
	handle @itcodeHost {
		@itcodeRoot path /
		handle @itcodeRoot {
			rewrite * /itcode.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# The page uses relative links, so it must live under a trailing slash
	handle /itcode {
		redir * /itcode/ permanent
	}

	handle /itcode/ {
		rewrite * /itcode.html
		root * /usr/share/caddy
		file_server
	}
}

# CloudFront HTTP: serve raw HTTP without redirecting
http://d1vajlb5xnngpm.cloudfront.net {
	import proxy_routes

	handle / {
		rewrite * /index.html
		root * /usr/share/caddy
		file_server
	}

	handle {
		root * /usr/share/caddy
		file_server
	}

	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		root * /usr/share/caddy
		file_server
	}
}

# HTTPS and on-demand TLS
:443 {
	import deny_hosts
	import proxy_routes
	import itcode_site

	# Special bot hostname
	@botHost host zaka.is-a.bot
	handle @botHost {
		@root path /
		handle @root {
			rewrite * /bot.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# Normal root page
	@normalRoot path /
	handle @normalRoot {
		rewrite * /index.html
		root * /usr/share/caddy
		file_server
	}

	handle {
		root * /usr/share/caddy
		file_server
	}

	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		root * /usr/share/caddy
		file_server
	}

	tls {
		on_demand
	}
}

# HTTP listener: X-Origin: cloudfront bypasses HTTPS redirects
:80 {
	import deny_hosts

	# Requests with this header remain on raw HTTP
	@cloudfrontOrigin header X-Origin cloudfront
	handle @cloudfrontOrigin {
		import proxy_routes

		handle / {
			rewrite * /index.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# CloudFront hostname also stays on HTTP
	@cloudfront header Host d1vajlb5xnngpm.cloudfront.net
	handle @cloudfront {
		import proxy_routes

		handle / {
			rewrite * /index.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# Private IP hosts stay on HTTP
	@private10 header Host 10.*
	@private192 header Host 192.168.*
	@private172 header_regexp Host ^172\.(1[6-9]|2[0-9]|3[0-1])\.

	handle @private10 {
		import flaresolverr

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	handle @private192 {
		import flaresolverr

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	handle @private172 {
		import flaresolverr

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# All other HTTP requests redirect to HTTPS. Wrapped in handle so it runs
	# last; a bare redir is ordered before handle and redirected everything.
	handle {
		redir https://{host}{uri} permanent
	}
}


{
	on_demand_tls {
		ask http://localhost/internal-check
	}
}


(proxy_routes) {
	
	# Upstream placeholders can't be combined with a scheme, so each scheme and
	# port form gets its own handler with an explicit dial address.
	@np_https {
		method GET
		path_regexp dest ^/np/https:/+(?P<domain>[^/:]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_https {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.domain}:443 {
			header_up Host {re.dest.domain}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"

			transport http {
				tls
				tls_server_name {re.dest.domain}
			}
		}
	}

	@np_https_port {
		method GET
		path_regexp dest ^/np/https:/+(?P<host>[^/:]+):(?P<port>[0-9]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_https_port {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.host}:{re.dest.port} {
			header_up Host {re.dest.host}:{re.dest.port}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"

			transport http {
				tls
				tls_server_name {re.dest.host}
			}
		}
	}

	@np_http {
		method GET
		path_regexp dest ^/np/http:/+(?P<domain>[^/:]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_http {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.domain}:80 {
			header_up Host {re.dest.domain}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"
		}
	}

	@np_http_port {
		method GET
		path_regexp dest ^/np/http:/+(?P<host>[^/:]+):(?P<port>[0-9]+)(?P<uri>/.*\.(?i:avif|apng|bmp|gif|ico|jfif|jpe?g|png|svg|tif?f|webp))$
	}

	handle @np_http_port {
		request_header -X-Forwarded-For
		request_header -X-Real-IP

		# Rewrite the path before proxying to the destination
		rewrite * {re.dest.uri}

		reverse_proxy {re.dest.host}:{re.dest.port} {
			header_up Host {re.dest.host}:{re.dest.port}
			header_up -X-Forwarded-For
			header_up -X-Real-IP

			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Allow-Methods "GET"
			header_down Access-Control-Allow-Headers "Content-Type"
		}
	}

	# Existing Wisp routes
	handle /api* {
		uri strip_prefix /api
		rewrite * /wisp{uri}

		reverse_proxy localhost:6001 {
			header_up Host {upstream_hostport}

			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /wisp* {
		reverse_proxy localhost:6001 {
			header_up Host {upstream_hostport}

			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Existing local /np proxy fallback
	handle /np/* {
		reverse_proxy localhost:6001 {
			header_up Host {upstream_hostport}
			header_up X-No-Proxy true

			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
}

# CloudFront HTTP: serve raw HTTP without redirecting
http://d1vajlb5xnngpm.cloudfront.net {
	import proxy_routes

	handle / {
		rewrite * /index.html
		root * /usr/share/caddy
		file_server
	}

	handle {
		root * /usr/share/caddy
		file_server
	}

	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		root * /usr/share/caddy
		file_server
	}
}

# HTTPS and on-demand TLS
:443 {
	@tooLong header_regexp Host ^.{61,}$
	@whm header Host *whm*
	@cpanel header Host *cpanel*
	@login header Host *login*

	respond @tooLong "Request denied" 493
	respond @whm "Request denied" 493
	respond @cpanel "Request denied" 493
	respond @login "Request denied" 493

	import proxy_routes

	# Special bot hostname
	@botHost host zaka.is-a.bot
	handle @botHost {
		@root path /
		handle @root {
			rewrite * /bot.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# Normal root page
	@normalRoot path /
	handle @normalRoot {
		rewrite * /index.html
		root * /usr/share/caddy
		file_server
	}

	handle {
		root * /usr/share/caddy
		file_server
	}

	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		root * /usr/share/caddy
		file_server
	}

	tls {
		on_demand
	}
}

# HTTP listener: X-Origin: cloudfront bypasses HTTPS redirects
:80 {
	@tooLong header_regexp Host ^.{61,}$
	@whm header Host *whm*
	@cpanel header Host *cpanel*
	@login header Host *login*

	respond @tooLong "Request denied" 493
	respond @whm "Request denied" 493
	respond @cpanel "Request denied" 493
	respond @login "Request denied" 493

	# Requests with this header remain on raw HTTP
	@cloudfrontOrigin header X-Origin cloudfront
	handle @cloudfrontOrigin {
		import proxy_routes

		handle / {
			rewrite * /index.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# CloudFront hostname also stays on HTTP
	@cloudfront header Host d1vajlb5xnngpm.cloudfront.net
	handle @cloudfront {
		import proxy_routes

		handle / {
			rewrite * /index.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	# Local hostname
	@localhost header Host localhost*
	handle @localhost {
		handle_path /flaresolverr/* {
			reverse_proxy localhost:8191
		}

		root * /usr/share/caddy
		file_server
	}

	# Private IP hosts stay on HTTP
	@private10 header Host 10.*
	@private192 header Host 192.168.*
	@private172 header_regexp Host ^172\.(1[6-9]|2[0-9]|3[0-1])\.

	handle @private10 {
		root * /usr/share/caddy
		file_server
	}

	handle @private192 {
		root * /usr/share/caddy
		file_server
	}

	handle @private172 {
		root * /usr/share/caddy
		file_server
	}

	# All other HTTP requests redirect to HTTPS
	redir https://{host}{uri} permanent
}

# Existing alternate HTTP port
http://:4000 {
	@tooLong header_regexp Host ^.{61,}$
	@whm header Host *whm*
	@cpanel header Host *cpanel*
	@login header Host *login*

	respond @tooLong "Request denied" 493
	respond @whm "Request denied" 493

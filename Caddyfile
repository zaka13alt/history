		@root path /
		handle @root {
			rewrite * /bot.html
			root * /usr/share/caddy
			file_server
		}

		handle {
			root * /usr/share/caddy
			file_server
		}
	}

	@normalRoot path /
	handle @normalRoot {
		rewrite * /index.html
		root * /usr/share/caddy
		file_server
	}

	handle {
		root * /usr/share/caddy
		file_server
	}

	handle_errors {
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		root * /usr/share/caddy
		file_server
	}
}

# Internal endpoint for the on-demand TLS ask check
http://localhost {
	respond /internal-check 200
}

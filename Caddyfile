{
    # Enable on-demand TLS globally with no validation limits
    on_demand_tls {
        ask "" 
    }
}

:443 {
    # Accept on-demand TLS certificates for this site
    tls internal {
        on_demand
    }

    # Match WebSocket upgrade requests on /wisp/
    @is_upgrade {
        path /wisp/*
        header Upgrade *
    }

    # Send WebSocket traffic to Node/service on port 3000
    handle @is_upgrade {
        reverse_proxy localhost:3000 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # Serve normal website
    handle {
        root * /usr/share/caddy
        file_server
    }
}

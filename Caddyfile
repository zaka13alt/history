:443 {
    tls internal

    # Match WebSocket upgrade requests on /wisp/
    @is_upgrade {
        path /wisp/*
        header Upgrade *
    }

    # Send WebSocket traffic to Node/service on port 8080
    handle @is_upgrade {
        reverse_proxy localhost:3000 {
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # Serve normal website
    handle {
        root * /usr/share/caddy
        file_server
    }
}
